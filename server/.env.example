# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Frontend CORS Origin (React dev client URL)
CLIENT_URL=http://localhost:5173

# ==============================================================================
# Database Configuration (MySQL / Amazon RDS MySQL)
# ==============================================================================
# For Local MySQL development:
#   DB_HOST=localhost
#   DB_PORT=3306
#   DB_USER=root
#   DB_PASSWORD=your_local_password
#   DB_NAME=campusconnect_db
#   DB_SSL=false
#
# For Amazon RDS for MySQL:
#   DB_HOST=campusconnect-db.xxxxxx.us-east-1.rds.amazonaws.com
#   DB_PORT=3306
#   DB_USER=admin
#   DB_PASSWORD=your_secure_rds_master_password
#   DB_NAME=campusconnect_db
#   DB_SSL=true
#   DB_SSL_REJECT_UNAUTHORIZED=true
#   DB_CONNECT_TIMEOUT=15000
# ==============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=campus_user
DB_PASSWORD=your_mysql_password
DB_NAME=campusconnect_db
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=15000
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Authentication & JWT Configuration
# In production, generate a cryptographically strong 64-byte random secret:
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
