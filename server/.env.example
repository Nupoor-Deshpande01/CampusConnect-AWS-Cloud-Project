# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Frontend CORS Origin (Local React dev origin)
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration (Placeholder)
DB_HOST=localhost
DB_PORT=3306
DB_USER=campus_user
DB_PASSWORD=your_mysql_password
DB_NAME=campusconnect_db
DB_CONNECTION_LIMIT=10

# JWT & Authentication Configuration
# In production, generate a cryptographically strong 64-byte random secret:
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Cookie Security Notes:
# In development (NODE_ENV=development): Cookies use secure=false, sameSite=lax for local HTTP.
# In production (NODE_ENV=production): Cookies use secure=true (HTTPS only), sameSite=none (if cross-site) or strict.
